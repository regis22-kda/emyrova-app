rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rooms - Anyone can read/write to join and submit answers
    match /rooms/{document} {
      allow read, write: if true;
    }

    // Questions - Read only globally
    match /questions/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Roulette Options - Anyone can read, Auth users can add custom ones
    match /roulette_options/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Users collection - Each user can only access their own data
    match /users/{userId} {
      // Allow authenticated users to read/write their own user document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // History subcollection - users can manage their own history
      match /history/{historyId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
